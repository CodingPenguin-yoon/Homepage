---
import '@fontsource-variable/inter';
import { Icon } from 'astro-icon/components';
import PageLayout from '~/layouts/PageLayout.astro';
import { homeProjects } from '~/data/home';
import { portfolioProfile } from '~/data/portfolio';

const metadata = {
  title: 'Yunho Cho | Platform Engineer',
  description: '인프라를 이해하고, 필요한 도구를 만드는 개발자 조윤호. 직접 만들고 운영한 프로젝트를 소개합니다.',
  ignoreTitleTemplate: true,
};
const githubHref = portfolioProfile.socials.github || 'https://github.com/CodingPenguin-yoon';
---

<PageLayout metadata={metadata}>
  <header slot="header" class="home-header" id="top">
    <a class="brand" href="#top" aria-label="조윤호 홈">조윤호<span>Yunho Cho</span></a>
    <nav aria-label="주요 메뉴">
      <a href="#projects">Work</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
      <a href="/portfolio">Portfolio</a>
      <a href="/resume">Resume</a>
    </nav>
  </header>

  <div class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">Yunho Cho<span class="period">.</span></h1>
      <p class="hero-role">Platform Engineer</p>
    </section>

    <section id="projects" class="work-section" aria-labelledby="work-title">
      <div class="section-heading"><h2 id="work-title">Selected work</h2><span>2025 — 2026</span></div>
      {
        homeProjects.map((project) => (
          <section class="project" id={project.id} aria-labelledby={`${project.id}-title`}>
            <span class="project-number">{project.index}</span>
            <div class="project-main">
              <p class="project-category">{project.category}</p>
              <h3 id={`${project.id}-title`}>
                <a href={project.caseStudyHref}>
                  {project.name}
                  <Icon name="tabler:arrow-up-right" />
                </a>
              </h3>
              <p class="project-statement">{project.statement}</p>
            </div>
            <div class="project-summary">
              <p>{project.description}</p>
              <div class="project-links">
                <>
                  <a href={project.caseStudyHref}>
                    프로젝트 보기 <Icon name="tabler:arrow-right" />
                  </a>
                  <a href={project.repository} target="_blank" rel="noreferrer">
                    GitHub <Icon name="tabler:arrow-up-right" />
                  </a>
                </>
              </div>
            </div>
          </section>
        ))
      }
    </section>

    <section id="about" class="about-section" aria-labelledby="about-title">
      <p class="section-label">About me</p>
      <div class="about-copy">
        <h2 id="about-title">필요해서 만들고,<br />직접 쓰면서 고칩니다.</h2>
        <p>
          게임 서버에서 시작한 관심이 인프라 구축과 서비스 운영으로 이어졌습니다. 서버와 네트워크를 직접 구성하고 여러
          서비스를 운영하면서, 반복하던 작업을 줄이는 도구를 만들기 시작했습니다.
        </p>
        <p>
          VM 운영 도구 Gjallar, 애플리케이션 배포 도구 Heimdall을 만들었습니다. 인프라를 이해하고 백엔드부터 화면까지
          연결하며, 동료들의 개발과 운영에도 도움이 되는 플랫폼을 만들고 싶습니다.
        </p>
        <div id="infrastructure" class="lab-note">
          <span>지금도 직접 운영 중</span><p>
            Proxmox 3노드 기반의 홈랩에서 서비스를 운영합니다.<br />이 홈페이지도 직접 만든 Heimdall로 배포합니다.
          </p>
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <div class="contact-top">
        <p class="section-label">Contact</p><p>개발과 인프라에 관한 이야기, 언제든 환영합니다.</p>
      </div>
      <h2 id="contact-title">
        <a href={`mailto:${portfolioProfile.email}`}>Let’s talk.<Icon name="tabler:arrow-up-right" /></a>
      </h2>
      <div class="contact-bottom">
        <a class="email" href={`mailto:${portfolioProfile.email}`}>{portfolioProfile.email}</a><div class="text-links">
          <a href={githubHref} target="_blank" rel="noreferrer">GitHub <Icon name="tabler:arrow-up-right" /></a><a
            href="/resume">이력서 <Icon name="tabler:arrow-up-right" /></a
          >
        </div>
      </div>
    </section>
  </div>

  <footer slot="footer" class="home-footer">
    <span>© 2026 Yunho Cho</span><a href="#top">Back to top <Icon name="tabler:arrow-up" /></a>
  </footer>
</PageLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 2rem;
  }
  :global(html body.bg-page) {
    background: #faf9f6;
    color: #181818;
  }
  .home-page,
  .home-header,
  .home-footer {
    font-family: var(--aw-font-sans), sans-serif;
    letter-spacing: 0;
  }
  .home-page {
    --ink: #181818;
    --muted: #65645f;
    --rule: #d5d4cf;
    color: var(--ink);
    background: #faf9f6;
  }
  .home-header,
  .hero,
  .work-section,
  .about-section,
  .home-footer {
    width: min(100% - 112px, 1440px);
    margin-inline: auto;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 7px;
  }
  :global(svg) {
    width: 1.1em;
    height: 1.1em;
    flex-shrink: 0;
  }
  .home-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 108px;
    color: #181818;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 18px;
    font-weight: 600;
  }
  .brand span {
    font-size: 13px;
    font-weight: 400;
    color: #65645f;
  }
  nav {
    display: flex;
    gap: 36px;
    font-size: 14px;
  }
  nav a {
    padding-block: 12px;
  }
  .hero {
    min-height: 570px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 72px 112px;
  }
  h1 {
    margin: 0 0 18px;
    font-family: 'Inter Variable', sans-serif;
    font-size: clamp(80px, 14.9vw, 222px);
    font-weight: 450;
    letter-spacing: -0.085em;
    line-height: 1.12;
    white-space: nowrap;
  }
  .hero-role {
    margin: 0;
    font-family: 'Inter Variable', sans-serif;
    font-size: clamp(22px, 3vw, 42px);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.4;
  }
  .period {
    font-weight: 350;
  }
  .text-links,
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }
  .text-links a,
  .project-links a,
  .home-footer a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .work-section {
    padding-top: 58px;
    padding-bottom: 110px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 25px;
    border-bottom: 1px solid var(--ink);
  }
  .section-heading h2 {
    font-size: 14px;
    font-weight: 500;
    margin: 0;
  }
  .section-heading span,
  .section-label {
    font-size: 12px;
    color: var(--muted);
  }
  .project {
    display: grid;
    grid-template-columns: 55px 1fr 1fr;
    gap: 25px;
    padding: 45px 0;
    border-bottom: 1px solid var(--rule);
  }
  .project-number {
    font-size: 12px;
    color: var(--muted);
    padding-top: 4px;
  }
  .project-category {
    font-size: 11px;
    color: var(--muted);
    margin: 0 0 18px;
  }
  .project h3 {
    margin: 0 0 13px;
    font-family: 'Inter Variable', sans-serif;
    font-weight: 450;
    font-size: clamp(30px, 3.6vw, 48px);
    letter-spacing: -0.045em;
    line-height: 1.15;
  }
  .project h3 a {
    display: inline-flex;
    align-items: center;
    gap: 20px;
  }
  .project h3 :global(svg) {
    width: 0.55em;
    height: 0.55em;
  }
  .project-statement {
    font-size: 13px;
    margin: 0;
    line-height: 1.7;
  }
  .project-summary {
    padding-top: 1px;
    max-width: 440px;
    justify-self: end;
  }
  .project-summary > p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.9;
    margin: 0 0 22px;
    word-break: keep-all;
  }
  .project-links {
    font-size: 12px;
  }
  .about-section {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 60px;
    padding: 70px 0 140px;
  }
  .section-label {
    margin: 7px 0 0;
  }
  .about-copy {
    max-width: 670px;
  }
  .about-copy h2 {
    margin: 0 0 38px;
    font-size: clamp(30px, 3.5vw, 48px);
    line-height: 1.4;
    letter-spacing: -0.05em;
    font-weight: 450;
  }
  .about-copy > p {
    margin: 0 0 22px;
    font-size: 15px;
    line-height: 2;
    color: var(--muted);
    word-break: keep-all;
  }
  .lab-note {
    border-top: 1px solid var(--rule);
    margin-top: 42px;
    padding-top: 25px;
  }
  .lab-note span {
    font-size: 12px;
  }
  .lab-note p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.9;
    margin-top: 12px;
  }
  .contact-section {
    background: #181818;
    color: #faf9f6;
    padding: 60px max(56px, calc((100% - 1440px) / 2)) 65px;
  }
  .contact-top,
  .contact-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .contact-top .section-label,
  .contact-top > p {
    color: #b8b7b2;
    font-size: 12px;
    margin: 0;
  }
  .contact-section h2 {
    font-size: clamp(40px, 7.8vw, 112px);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 1.3;
    margin: 64px 0;
  }
  .contact-section h2 a {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .contact-section h2 :global(svg) {
    width: 0.9em;
    height: 0.9em;
  }
  .contact-bottom {
    font-size: 13px;
  }
  .home-footer {
    display: flex;
    justify-content: space-between;
    padding-block: 26px;
    font-size: 11px;
    color: #65645f;
  }
  @media (min-width: 1536px) {
    :global(html) {
      font-size: 16px;
    }
  }
  @media (max-width: 760px) {
    .home-header,
    .hero,
    .work-section,
    .about-section,
    .home-footer {
      width: calc(100% - 40px);
    }
    .home-header {
      min-height: 84px;
      height: auto;
      flex-wrap: wrap;
      gap: 8px 20px;
      padding-block: 18px;
    }
    .brand {
      font-size: 16px;
    }
    .brand span {
      display: none;
    }
    nav {
      gap: 15px;
      font-size: 11px;
    }
    .hero {
      min-height: 430px;
      padding-block: 70px 110px;
    }
    h1 {
      font-size: 14.7vw;
      margin: 0 0 16px;
    }
    .work-section {
      padding-top: 50px;
      padding-bottom: 35px;
    }
    .project {
      grid-template-columns: 24px 1fr;
      gap: 18px;
      padding: 30px 0;
    }
    .project h3 {
      font-size: 34px;
    }
    .project-summary {
      grid-column: 2;
      max-width: none;
      justify-self: stretch;
    }
    .project-summary > p {
      font-size: 13px;
    }
    .about-section {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 55px 0 75px;
    }
    .about-copy h2 {
      font-size: 31px;
      margin-bottom: 26px;
    }
    .about-copy > p {
      font-size: 14px;
    }
    .contact-section {
      padding: 36px 20px;
    }
    .contact-top {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }
    .contact-section h2 {
      margin: 42px 0;
      font-size: 10vw;
    }
    .contact-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 24px;
    }
    .email {
      overflow-wrap: anywhere;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
